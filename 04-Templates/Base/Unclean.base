filters:
  and:
    - file.hasProperty("tags")
    - file.tags.isEmpty()
    - '!file.inFolder("04-Templates")'
views:
  - type: table
    name: Table
    order:
      - file.name
      - aliases
      - date
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 176
      note.aliases: 174
      note.date: 120
